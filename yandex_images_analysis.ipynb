   "source": [
    "def day_period(hour):\n",
    "    if 0 <= hour <= 5:\n",
    "        return 'Ночь 00–05'\n",
    "    if 6 <= hour <= 10:\n",
    "        return 'Утро 06–10'\n",
    "    if 11 <= hour <= 18:\n",
    "        return 'День 11–18'\n",
    "    return 'Вечер 19–23'\n",
    "\n",
    "period_order = ['Ночь 00–05', 'Утро 06–10', 'День 11–18', 'Вечер 19–23']\n",
    "period_df = df[['platform', 'hour_msk']].copy()\n",
    "period_df['day_period'] = period_df['hour_msk'].map(day_period)\n",
    "period_summary = period_df.groupby(['platform', 'day_period'], observed=True).size().rename('requests').reset_index()\n",
    "period_summary['share_pct'] = period_summary['requests'] / period_summary['platform'].astype(str).map(platform_totals) * 100\n",
    "period_pivot = period_summary.pivot(index='day_period', columns='platform', values='share_pct').reindex(period_order)\n",
    "display(period_pivot.round(2))"
   ]
  },
