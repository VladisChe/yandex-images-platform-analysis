   "source": [
    "df = pd.read_csv(\n",
    "    DATA_PATH,\n",
    "    sep='\\t',\n",
    "    header=None,\n",
    "    names=['query', 'timestamp', 'platform'],\n",
    "    dtype={'query': 'string', 'timestamp': 'int64', 'platform': 'category'},\n",
    ")\n",
    "\n",
    "df['query_norm'] = (\n",
    "    df['query'].str.lower().str.strip().str.replace(r'\\s+', ' ', regex=True)\n",
    ")\n",
    "df['datetime_utc'] = pd.to_datetime(df['timestamp'], unit='s', utc=True)\n",
    "df['datetime_msk'] = df['datetime_utc'].dt.tz_convert('Europe/Moscow')\n",
    "df['date_msk'] = df['datetime_msk'].dt.date\n",
    "df['hour_msk'] = df['datetime_msk'].dt.hour\n",
    "df['weekday_msk'] = df['datetime_msk'].dt.dayofweek\n",
    "\n",
    "print(f\"Строк: {len(df):,}\".replace(',', ' '))\n",
    "display(df.head())"
   ]
