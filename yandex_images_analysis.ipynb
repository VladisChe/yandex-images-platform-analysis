    }
   ],
   "source": [
    "sql_df = df[['query_norm', 'timestamp', 'platform', 'datetime_msk', 'date_msk', 'hour_msk']].copy()\n",
    "sql_df['platform'] = sql_df['platform'].astype(str)\n",
    "sql_df['datetime_msk'] = sql_df['datetime_msk'].astype(str)\n",
    "sql_df['date_msk'] = sql_df['date_msk'].astype(str)\n",
    "\n",
    "con = sqlite3.connect(':memory:')\n",
    "sql_df.to_sql('queries', con, index=False, if_exists='replace')\n",
    "con.execute('CREATE INDEX idx_queries_platform ON queries(platform)')\n",
    "con.execute('CREATE INDEX idx_queries_query ON queries(query_norm)')\n",
    "con.execute('CREATE INDEX idx_queries_hour ON queries(hour_msk)')\n",
    "print('SQLite-таблица создана:', f\"{len(sql_df):,}\".replace(',', ' '), 'строк')"
   ]
  },
