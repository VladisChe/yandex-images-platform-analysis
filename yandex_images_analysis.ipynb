   "source": [
    "topic_rows = []\n",
    "for topic, pattern in topic_patterns.items():\n",
    "    mask = df['query_norm'].str.contains(pattern, regex=True, na=False)\n",
    "    counts = df.loc[mask].groupby('platform', observed=True).size().reindex(['desktop', 'touch'], fill_value=0)\n",
    "    desktop_count = int(counts['desktop'])\n",
    "    touch_count = int(counts['touch'])\n",
    "    desktop_share = desktop_count / platform_totals['desktop'] * 100\n",
    "    touch_share = touch_count / platform_totals['touch'] * 100\n",
    "    topic_rows.append({\n",
    "        'topic': topic,\n",
    "        'desktop_count': desktop_count,\n",
    "        'touch_count': touch_count,\n",
    "        'desktop_share_pct': desktop_share,\n",
    "        'touch_share_pct': touch_share,\n",
    "        'diff_pp_touch_minus_desktop': touch_share - desktop_share,\n",
    "        'touch_to_desktop_ratio': (touch_share + 1e-9) / (desktop_share + 1e-9),\n",
    "    })\n",
    "\n",
