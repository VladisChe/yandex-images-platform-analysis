    "platform_totals = df['platform'].value_counts()\n",
    "\n",
    "youtube_exact = (\n",
    "    df.loc[df['query_norm'].eq('ютуб')]\n",
    "    .groupby('platform', observed=True).size()\n",
    "    .reindex(['desktop', 'touch'], fill_value=0)\n",
    "    .rename('exact_requests').reset_index()\n",
    ")\n",
    "youtube_exact['platform_requests'] = youtube_exact['platform'].astype(str).map(platform_totals)\n",
    "youtube_exact['share_pct'] = youtube_exact['exact_requests'] / youtube_exact['platform_requests'] * 100\n",
    "\n",
    "youtube_contains = (\n",
    "    df.loc[df['query_norm'].str.contains('ютуб', regex=False, na=False)]\n",
    "    .groupby('platform', observed=True).size()\n",
    "    .reindex(['desktop', 'touch'], fill_value=0)\n",
    "    .rename('contains_requests').reset_index()\n",
    ")\n",
    "youtube_result = youtube_exact.merge(youtube_contains, on='platform')\n",
    "display(youtube_result)"
   ]
