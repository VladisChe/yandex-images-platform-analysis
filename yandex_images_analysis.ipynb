   "source": [
    "top10 = df.groupby(['platform', 'query_norm'], observed=True).size().rename('requests').reset_index()\n",
    "top10['share_pct'] = top10['requests'] / top10['platform'].astype(str).map(platform_totals) * 100\n",
    "top10 = (\n",
    "    top10.sort_values(['platform', 'requests', 'query_norm'], ascending=[True, False, True])\n",
    "    .groupby('platform', observed=True).head(10).copy()\n",
    ")\n",
    "top10['rank'] = top10.groupby('platform', observed=True).cumcount() + 1\n",
    "top10 = top10[['platform', 'rank', 'query_norm', 'requests', 'share_pct']]\n",
    "display(top10)"
   ]
  },
