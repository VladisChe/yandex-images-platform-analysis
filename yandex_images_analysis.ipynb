    "sql_date_range = \"\"\"\n",
    "SELECT\n",
    "    MIN(datetime_msk) AS min_datetime_msk,\n",
    "    MAX(datetime_msk) AS max_datetime_msk,\n",
    "    COUNT(*) AS requests,\n",
    "    COUNT(DISTINCT query_norm) AS unique_queries\n",
    "FROM queries;\n",
    "\"\"\"\n",
    "display(pd.read_sql_query(sql_date_range, con))\n",
    "\n",
    "sql_platforms = \"\"\"\n",
    "SELECT\n",
    "    platform,\n",
    "    COUNT(*) AS requests,\n",
    "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS share_pct\n",
    "FROM queries\n",
    "GROUP BY platform\n",
    "ORDER BY requests DESC;\n",
    "\"\"\"\n",
    "display(pd.read_sql_query(sql_platforms, con))"
