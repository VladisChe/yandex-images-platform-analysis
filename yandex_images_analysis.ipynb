   "source": [
    "sql_top10 = \"\"\"\n",
    "WITH query_frequency AS (\n",
    "    SELECT platform, query_norm, COUNT(*) AS requests\n",
    "    FROM queries\n",
    "    GROUP BY platform, query_norm\n",
    "),\n",
    "ranked AS (\n",
    "    SELECT\n",
    "        platform,\n",
    "        query_norm,\n",
    "        requests,\n",
    "        ROW_NUMBER() OVER (\n",
    "            PARTITION BY platform\n",
    "            ORDER BY requests DESC, query_norm\n",
    "        ) AS rn\n",
    "    FROM query_frequency\n",
    ")\n",
    "SELECT platform, rn AS rank, query_norm, requests\n",
    "FROM ranked\n",
    "WHERE rn <= 10\n",
    "ORDER BY platform, rank;\n",
    "\"\"\"\n",
    "top10_sql = pd.read_sql_query(sql_top10, con)\n",
    "display(top10_sql)"
   ]
