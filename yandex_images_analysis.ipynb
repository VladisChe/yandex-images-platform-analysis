   "source": [
    "## 8. Data-driven проверка тематических выводов"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "02bd19f8",
   "metadata": {},
   "source": [
    "Для независимой проверки словарного подхода сравниваются слова и биграммы по относительной частоте. Положительный `log2_touch_desktop` означает перевес touch, отрицательный — desktop."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "cd0a6613",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-29T11:34:17.676982Z",
     "iopub.status.busy": "2026-07-29T11:34:17.676861Z",
     "iopub.status.idle": "2026-07-29T11:34:18.125740Z",
     "shell.execute_reply": "2026-07-29T11:34:18.124615Z"
    }
   },
   "outputs": [],
   "source": [
    "query_platform = df.groupby(['query_norm', 'platform'], observed=True).size().unstack(fill_value=0)\n",
    "\n",
    "russian_stopwords = [\n",
    "    'и', 'в', 'во', 'на', 'с', 'со', 'к', 'ко', 'по', 'из', 'за', 'для', 'от', 'до', 'у', 'о', 'об', 'про',\n",
    "    'а', 'но', 'или', 'как', 'что', 'это', 'этот', 'эта', 'эти', 'не', 'без', 'при', 'под', 'над',\n",
    "    'фото', 'фотографии', 'картинка', 'картинки', 'изображение', 'изображения', 'скачать', 'бесплатно',\n",
    "    'смотреть', 'онлайн', 'год', 'года', '2021', '2022', 'текст', 'видео', 'новые', 'новый',\n",
    "    'красивая', 'красивые', 'красивый', 'большие', 'лучшие',\n",
    "]\n",
    "\n",
    "vectorizer = CountVectorizer(\n",
    "    lowercase=False,\n",
    "    token_pattern=r'(?u)\\b[а-яёa-z0-9]{2,}\\b',\n",
    "    ngram_range=(1, 2),\n",
    "    binary=True,\n",
    "    stop_words=russian_stopwords,\n",
    "    min_df=2,\n",
    ")\n",
    "X = vectorizer.fit_transform(query_platform.index)\n",
    "terms = np.array(vectorizer.get_feature_names_out())\n",
    "desktop_term_requests = np.asarray(X.T.dot(query_platform['desktop'].to_numpy())).ravel()\n",
    "touch_term_requests = np.asarray(X.T.dot(query_platform['touch'].to_numpy())).ravel()\n",
    "\n",
    "term_contrast = pd.DataFrame({'term': terms, 'desktop_count': desktop_term_requests, 'touch_count': touch_term_requests})\n",
    "term_contrast['desktop_share'] = term_contrast['desktop_count'] / platform_totals['desktop']\n",
    "term_contrast['touch_share'] = term_contrast['touch_count'] / platform_totals['touch']\n",
    "term_contrast['total_count'] = term_contrast['desktop_count'] + term_contrast['touch_count']\n",
    "epsilon = 1e-5\n",
    "term_contrast['log2_touch_desktop'] = np.log2((term_contrast['touch_share'] + epsilon) / (term_contrast['desktop_share'] + epsilon))\n",
    "term_contrast = term_contrast[term_contrast['total_count'] >= 300]"
   ]
  },
